# =============================
# Stage 1 - Build (Maven)
# =============================
FROM maven:3.9.9-amazoncorretto-21-al2023 AS build

WORKDIR /build

COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# =============================
# Stage 2 - Runtime
# =============================
FROM amazoncorretto:21

WORKDIR /app

# Copia o JAR da aplicação
COPY --from=build /build/target/*.jar /app/app.jar

# Copia o Java Agent do OpenTelemetry
COPY opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar

# =============================
# Configurações de OpenTelemetry
# =============================
# Mantida: Atributo de recurso, é útil para identificação no Grafana/Tempo
ENV OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod

# Força o Java Agent automaticamente
ENV JAVA_TOOL_OPTIONS="-javaagent:/app/opentelemetry-javaagent.jar"

# Porta da API
EXPOSE 8085

ENTRYPOINT ["sh", "-c", "java $JAVA_TOOL_OPTIONS -jar /app/app.jar"]